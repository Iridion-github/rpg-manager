# Copy to .env for local use, or set these in your host's dashboard.
# .env is gitignored; never commit real values.
#
# `npm start` and `npm run dev` read ../.env automatically, through Node's own
# --env-file-if-exists (see server/package.json). No dotenv dependency, and no
# exporting things into the shell before starting. "if-exists" so a deployment
# that gets its configuration from a dashboard instead does not fail for want
# of a file it was never going to have.

# Required unless you start with `npm run dev`. This is the admin's login
# password - sign in with username `admin`.
ADMIN_PASSWORD=change-me

# Set this to close registration to people who know the code. Leave it unset
# and anyone who can reach the URL can sign up - fine on your own machine,
# not on a public hostname.
SIGNUP_CODE=

# --- mail ---
# Without SMTP_PASS the app sends nothing: confirmation and password-reset
# links are written to data/outbox.log instead, and the startup banner says so.
# Everything else about mail has a sensible default.

# The sending mailbox's password. At Gmail this must be an *app password*
# (myaccount.google.com/apppasswords, after 2-Step Verification is on); the
# account's own password is refused. The one value here that is genuinely a
# secret.
SMTP_PASS=

# The address letters come from, and the SMTP login. Not a secret - it is
# printed on every letter - and it already has a default in server/mailer.js.
# Set it only to send from a different mailbox.
SITE_EMAIL=

# The submission server. Inferred for @gmail.com; required for anything else.
SMTP_HOST=
SMTP_PORT=587

# Where the SQLite database and uploaded maps live. On Render this is the
# disk mount path.
DATA_DIR=./data

# Localhost by default so a tunnel is the only way in. Hosting platforms need
# 0.0.0.0 or their router can't reach the app.
HOST=127.0.0.1

# Usually injected by the host; 3001 locally.
PORT=3001

# Number of proxies in front of the app. Required behind Render or a Cloudflare
# Tunnel, or every request looks like it came from the same address and the
# rate limiter treats the whole table as one attacker.
TRUST_PROXY=
