# Dependencies
node_modules/

# App data - YOUR local "database" lives here. Never commit it.
/data/

# Build output
client/dist/
server/dist/

# Env / secrets
.env
.env.local
secrets.txt
secrets/
*.secret
*.key

# Personal scratch - half-formed ideas, not documentation.
notes.txt

# Where a Claude session leaves its context for the next one to pick up. A
# handoff note between sittings, not a record of the project - what matters
# ends up in the README, the code comments, or NEXT-STEPS.md.
last-session.txt

# Your real tunnel config names your hostname and points at credentials.
# config.example.yml is the one that's committed.
cloudflared/config.yml
cloudflared/*.json

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
